{
  "name": "kiwi-photo-library",
  "version": "1.3.0",
  "private": true,
  "description": "A scalable browser for Eagle photo libraries",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "server",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "node scripts/start.js",
    "start": "node scripts/start.js",
    "start:no-open": "node scripts/start.js --no-open",
    "build": "npm run build:contracts && npm run build:web && npm run build:server",
    "build:contracts": "npm run build --workspace @kiwi/contracts",
    "build:web": "npm run build:contracts && npm run typecheck:web && vite build",
    "build:server": "npm run build:contracts && npm run build --workspace @kiwi/server",
    "typecheck": "npm run build:contracts && npm run typecheck:web && npm run typecheck --workspace @kiwi/server",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/src/**/*.mts\" \"server/test/**/*.mts\" \"packages/contracts/src/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.{js,mjs}\" \"*.{js,ts,json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/src/**/*.mts\" \"server/test/**/*.mts\" \"packages/contracts/src/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.{js,mjs}\" \"*.{js,ts,json,md,yml,yaml}\" \".github/**/*.{yml,yaml}\" \"docs/**/*.md\"",
    "test": "vitest run && npm test --workspace @kiwi/server",
    "test:coverage": "vitest run --coverage && npm run test:coverage --workspace @kiwi/server",
    "pretest:e2e": "npm run build && node scripts/prepare-e2e.js",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 127.0.0.1",
    "audit": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@kiwi/contracts": "1.3.0",
    "@tanstack/react-query": "^5.101.4",
    "epubjs": "^0.3.93",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-masonry-css": "^1.0.16",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.0.0"
  },
  "keywords": [
    "photo-library",
    "media-browser",
    "react",
    "typescript",
    "eagle"
  ],
  "overrides": {
    "@xmldom/xmldom": "^0.9.11"
  },
  "license": "MIT"
}

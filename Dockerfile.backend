FROM node:22-bookworm-slim AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ pkg-config \
    && rm -rf /var/lib/apt/lists/*
ENV npm_config_cache=/tmp/.npm

COPY package.json package-lock.json ./
COPY server/package.json server/package.json
COPY packages/contracts/package.json packages/contracts/package.json
RUN npm ci

COPY packages/contracts packages/contracts
COPY server server
RUN npm run build:contracts \
    && npm run typecheck --workspace @kiwi/server \
    && npm run build --workspace @kiwi/server \
    && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
WORKDIR /app/server
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production PORT=3001 HOST=0.0.0.0 KIWI_DATA_DIR=/app/data
COPY --from=builder --chown=node:node /app/node_modules /app/node_modules
COPY --from=builder --chown=node:node /app/packages/contracts /app/packages/contracts
COPY --from=builder --chown=node:node /app/server /app/server
RUN mkdir -p /app/data/libraries /app/data/databases && chown -R node:node /app/data

USER node
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:3001/api/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/index.mjs"]

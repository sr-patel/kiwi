{
  "name": "@kiwi/server",
  "version": "1.2.3",
  "private": true,
  "description": "Backend API and Eagle library indexer for Kiwi",
  "type": "module",
  "main": "dist/index.mjs",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.mjs",
    "dev": "tsx watch src/index.mts",
    "test": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts"
  },
  "dependencies": {
    "@kiwi/contracts": "1.2.3",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "license": "MIT"
}

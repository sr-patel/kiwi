{
  "name": "@kiwi/server",
  "version": "1.3.1",
  "private": true,
  "description": "Backend API and Eagle library indexer for Kiwi",
  "type": "module",
  "main": "dist/index.mjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.mjs",
    "dev": "tsx watch src/index.mts",
    "test": "vitest run --config vitest.config.mts",
    "test:coverage": "vitest run --coverage --config vitest.config.mts"
  },
  "dependencies": {
    "@kiwi/contracts": "1.3.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^6.0.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.3",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
